# ---------------------------------------------------------------------------
# tradabot -- development defaults.
# Copy to `.env` and adjust. Never commit `.env`.
# All variables are prefixed with TRADABOT_ and map onto app/core/config.py.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
TRADABOT_ENV=development
TRADABOT_DEBUG=true
TRADABOT_LOG_LEVEL=INFO
# json | console
TRADABOT_LOG_FORMAT=console
TRADABOT_API_HOST=0.0.0.0
TRADABOT_API_PORT=8000

# --- Database -------------------------------------------------------------
# Used by docker-compose to provision the TimescaleDB container.
POSTGRES_USER=tradabot
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=tradabot
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by the application.
# Inside docker-compose the host is `db`; from the host machine it is `localhost`.
TRADABOT_DATABASE_URL=postgresql+asyncpg://tradabot:change-me-in-your-local-env@localhost:5432/tradabot
TRADABOT_DB_ECHO=false
TRADABOT_DB_POOL_SIZE=5
TRADABOT_DB_MAX_OVERFLOW=10

# --- Market data ----------------------------------------------------------
# mock | alpaca. `mock` needs no credentials and stays the default: every test
# runs against it, so the suite never touches the network.
TRADABOT_MARKET_DATA_PROVIDER=mock
# Seed for the deterministic mock provider. Same seed => same candles.
TRADABOT_MOCK_SEED=1337

# Symbols synced by `market-data sync` when none are named.
TRADABOT_MARKET_DATA__WATCHLIST=AAPL,MSFT,NVDA,AMD,AMZN,META,GOOGL,TSLA
# Exchange calendar used for sessions, holidays and holding periods.
TRADABOT_MARKET_DATA__DEFAULT_EXCHANGE=XNAS
# A quote older than this is treated as stale and refused for execution.
TRADABOT_MARKET_DATA__MAX_QUOTE_AGE_SECONDS=900
# Whether a market-data quote may stand in for a broker execution quote.
# It is an approximation: a retail broker's spread is not the consolidated one.
TRADABOT_MARKET_DATA__TREAT_PROVIDER_QUOTE_AS_EXECUTABLE=true

# --- Alpaca (optional; only needed when the provider is `alpaca`) ----------
# MARKET DATA ONLY. tradabot places no orders, paper or otherwise.
# Create keys at https://app.alpaca.markets -- paper keys are sufficient.
# LEAVE THESE EMPTY HERE. Put real values only in your own `.env`, which is
# git-ignored. Never commit a key, never paste one into documentation or an
# issue: the API cannot tell a leaked key from a legitimate one.
TRADABOT_ALPACA__API_KEY=
TRADABOT_ALPACA__API_SECRET=
# iex (free, single venue, ~2-3% of consolidated volume)
# sip (paid, full consolidated tape) | delayed_sip (free, 15-minute delay)
TRADABOT_ALPACA__FEED=iex
TRADABOT_ALPACA__REQUEST_TIMEOUT_SECONDS=30.0
# Bounded on purpose: an unbounded retry loop turns an outage into a hang.
TRADABOT_ALPACA__MAX_RETRIES=4
TRADABOT_ALPACA__BACKOFF_BASE_SECONDS=0.5
TRADABOT_ALPACA__BACKOFF_MAX_SECONDS=30.0
TRADABOT_ALPACA__MAX_BARS_PER_REQUEST=10000

# --- Trading costs --------------------------------------------------------
# Baseline heuristics -- NOT calibrated against a real broker yet.
# Fixed fee charged per order, in account currency.
TRADABOT_COSTS__ORDER_FEE=1.00
# Variable fee as a fraction of notional (0.0005 == 5 bps).
TRADABOT_COSTS__VARIABLE_FEE_RATE=0.0
# Assumed slippage as a fraction of the half-spread actually paid.
TRADABOT_COSTS__SLIPPAGE_SPREAD_MULTIPLE=0.5
# Fallback spread (bps) used when no quote is available.
TRADABOT_COSTS__DEFAULT_SPREAD_BPS=10.0

# --- Signal engine --------------------------------------------------------
# Baseline heuristic weights. Must sum to 1.0. See docs/architecture.md.
TRADABOT_SIGNALS__WEIGHTS__MOMENTUM=0.25
TRADABOT_SIGNALS__WEIGHTS__VOLUME=0.25
TRADABOT_SIGNALS__WEIGHTS__TREND=0.20
TRADABOT_SIGNALS__WEIGHTS__VOLATILITY=0.10
TRADABOT_SIGNALS__WEIGHTS__REGIME=0.10
TRADABOT_SIGNALS__WEIGHTS__SPREAD=0.10
# Absolute score thresholds for classification (0..100).
TRADABOT_SIGNALS__BULLISH_THRESHOLD=20.0
TRADABOT_SIGNALS__STRONG_BULLISH_THRESHOLD=55.0
# Minimum candle history before a signal is produced.
TRADABOT_SIGNALS__MIN_BARS=60
# Fraction of the typical horizon RANGE a full-conviction signal is assumed to
# capture as directional drift. Purely a placeholder -- the entire net-edge
# filter scales with it, so it is the first number to calibrate in phase 7.
TRADABOT_SIGNALS__EXPECTED_MOVE_CAPTURE_RATIO=0.25

# --- Notifications --------------------------------------------------------
# Master switch for every backend. Thresholds below control notification
# VOLUME ONLY: every signal is still computed, scored and persisted regardless.
# See docs/notifications.md -- the database is the future ML dataset and must
# never be shaped by what happened to be interesting on a chat channel.
TRADABOT_NOTIFICATIONS__ENABLED=true
# Echo notifications to the log. Useful locally; independent of Discord.
TRADABOT_NOTIFICATIONS__CONSOLE=false

# Score at or above which a signal is announced. An engineering default chosen
# to keep volume low -- NOT a claim that 75 means anything.
TRADABOT_NOTIFICATIONS__SIGNAL_THRESHOLD=75
# Above this, an upgrade is announced. Must be >= SIGNAL_THRESHOLD.
TRADABOT_NOTIFICATIONS__STRONG_SIGNAL_THRESHOLD=85
# Minimum gap between notifications about the same subject.
TRADABOT_NOTIFICATIONS__SIGNAL_COOLDOWN_MINUTES=60
# A re-notification needs at least this much score movement.
TRADABOT_NOTIFICATIONS__MINIMUM_SCORE_CHANGE=5
# Opportunities listed in a market overview.
TRADABOT_NOTIFICATIONS__OVERVIEW_SIZE=5
# Discord's hard limit is 2000; the margin absorbs the wrapper.
TRADABOT_NOTIFICATIONS__MAX_MESSAGE_CHARACTERS=1900

# --- Discord (optional) ---------------------------------------------------
# OUTPUT ONLY. Discord is a monitoring surface; no trading logic depends on it,
# and a Discord outage never fails a sync or rolls back a paper trade.
#
# A WEBHOOK URL IS A BEARER CREDENTIAL: anyone holding one can post to that
# channel as tradabot. LEAVE THESE EMPTY HERE. Put real values only in your own
# `.env`, which is git-ignored. Never commit one, never paste one into an issue
# or documentation -- Discord cannot tell a leaked webhook from a legitimate one.
TRADABOT_DISCORD__ENABLED=false
TRADABOT_DISCORD__MARKET_WEBHOOK=
TRADABOT_DISCORD__TRADES_WEBHOOK=
TRADABOT_DISCORD__PERFORMANCE_WEBHOOK=
TRADABOT_DISCORD__SYSTEM_WEBHOOK=
TRADABOT_DISCORD__REQUEST_TIMEOUT_SECONDS=10.0
# Bounded. A notification is worth retrying, never worth hanging for.
TRADABOT_DISCORD__MAX_RETRIES=3
TRADABOT_DISCORD__BACKOFF_BASE_SECONDS=0.5
TRADABOT_DISCORD__BACKOFF_MAX_SECONDS=15.0
TRADABOT_DISCORD__USERNAME=tradabot
