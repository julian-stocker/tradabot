# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
reports/

# Environment / secrets
.env
.env.*
!.env.example

# Scheduled-job logs (launchd writes here; never committed)
logs/

# Local data
data/
*.db
*.sqlite3
# SQLite write-ahead-log sidecars. Transient runtime state that SQLite
# creates and checkpoints away; `*.db` does not match them, so they were
# committed once by accident (8878421).
*.db-wal
*.db-shm

# Editors / OS
.idea/
.vscode/
.DS_Store
